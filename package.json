{
  "name": "repo-template-astro",
  "private": true,
  "description": "Astro + TypeScript + Tailwind starter template",
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,astro}\"",
    "lint:fix": "eslint --fix \"**/*.{js,mjs,cjs,ts,astro}\"",
    "format": "prettier --check \"**/*.{js,mjs,cjs,ts,astro,md,mdx}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,ts,astro,md,mdx}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run lint && pnpm run format && pnpm run test && pnpm run build",
    "clean": "rm -rf .astro dist node_modules coverage"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.1.18",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.1.14",
    "astro": "^6.1.6",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.0.18"
  }
}
